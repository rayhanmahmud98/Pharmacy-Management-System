# MediNest Pharmacy Management System - Environment Configuration
# Copy this file to .env and configure your local or LAN PostgreSQL credentials.

# Server Host & Port
PORT=3000
BIND_HOST=0.0.0.0
NODE_ENV=production
COOKIE_SECURE=false

# Security & Proxy Headers (Keep false for direct LAN deployment so clients cannot spoof X-Forwarded-For)
TRUST_PROXY=false

# PostgreSQL Connection (either set DATABASE_URL OR individual PG* variables)
# DATABASE_URL="postgresql://medinest_user:CHANGE_ME@127.0.0.1:5432/medinest"
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=medinest
PGUSER=postgres
PGPASSWORD=
PGSSL=disable
PGPOOL_MAX=20
PG_CONNECT_RETRIES=6

# Local storage directory for pg_dump backup archives and Excel upload staging
# On Windows production servers prefer a persistent non-app path such as: C:\ProgramData\MediNest
PHARMACY_DATA_DIR="./data"

# Optional override for PostgreSQL client binaries directory (pg_dump, pg_restore)
# Leave commented if PostgreSQL bin is already in PATH or installed at C:\Program Files\PostgreSQL\<15|16|17>\bin
# PG_BIN_DIR="C:\Program Files\PostgreSQL\15\bin"

# Optional external application URL
APP_URL="http://localhost:3000"
